# ============ Embedding（目标配置：火山方舟 Seed1.5-Embedding）============
# Seed1.5-Embedding 在方舟上的模型 ID：doubao-embedding-large-text-250515
# API Key 获取：https://console.volcengine.com/ark
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_API_KEY=填入你的方舟APIKey
EMBEDDING_MODEL=doubao-embedding-large-text-250515
# MRL 支持 256/512/1024/2048（自动降维+归一化）
EMBEDDING_DIM=2048
# 查询侧指令前缀（Seed1.5 官方推荐写法；换其他模型时置空即可）
EMBEDDING_QUERY_INSTRUCT=Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery:

# ============ LLM（任意 OpenAI 兼容接口均可）============
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=填入你的APIKey
LLM_MODEL=doubao-seed-1.6-flash-250828

# ============ 路径与检索默认值 ============
RAW_DIR=./Raw
LANCEDB_DIR=./data/lancedb
TOP_K=8
